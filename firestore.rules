rules_version = '2';
// Security rules shared by both sites (psych-scales-lab and psych-stats-lab).
// Default: everything is denied unless a rule below allows it.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isStr(v, max) { return v is string && v.size() <= max; }
    function isInt(v, max) { return v is int && v >= 0 && v <= max; }
    // write throttle: a document may change at most once every 2 seconds
    // admin = a document admins/{uid} created by hand in the Firebase console (no email or secret in this file)
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function throttled() { return resource == null || !('updated' in resource.data) || request.time > resource.data.updated + duration.value(2, 's'); }

    // ---- per-user progress (one document per account; only its owner can read or write it) ----
    match /users/{uid} {
      allow read, delete: if isUser(uid);
      allow create, update: if isUser(uid)
        && request.resource.data.keys().hasOnly(['name', 'scales', 'stats', 'prefs', 'updated'])
        && (!('name' in request.resource.data) || isStr(request.resource.data.name, 40))
        && (!('scales' in request.resource.data) || (request.resource.data.scales.keys().hasOnly(['state', 'xp']) && isStr(request.resource.data.scales.state, 400000)))
        && (!('stats' in request.resource.data) || (request.resource.data.stats.keys().hasOnly(['state', 'xp']) && isStr(request.resource.data.stats.state, 400000)))
        && (!('prefs' in request.resource.data) || request.resource.data.prefs.keys().hasOnly(['lb']))
        && (!('updated' in request.resource.data) || request.resource.data.updated == request.time)
        && throttled();

      // saved scales (definitions + their responses), private to the owner
      match /scales/{sid} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && request.resource.data.keys().hasOnly(['json', 'updated'])
          && isStr(request.resource.data.json, 900000)
          && request.resource.data.updated == request.time;
      }
    }

    // ---- leaderboard: opt-in, verified accounts only, readable by signed-in users ----
    match /leaderboard/{uid} {
      allow read: if signedIn();
      allow delete: if isUser(uid);
      allow create, update: if isUser(uid) && verified()
        && request.resource.data.keys().hasOnly(['name', 'xp', 'w', 'total', 'week', 'updated'])
        && isStr(request.resource.data.name, 40)
        && request.resource.data.xp.keys().hasOnly(['scales', 'stats'])
        && request.resource.data.w.keys().hasOnly(['scales', 'stats'])
        && isInt(request.resource.data.xp.scales, 1000000) && isInt(request.resource.data.xp.stats, 1000000)
        && isInt(request.resource.data.w.scales, 1000000) && isInt(request.resource.data.w.stats, 1000000)
        && request.resource.data.total == request.resource.data.xp.scales + request.resource.data.xp.stats
        && request.resource.data.week == request.resource.data.w.scales + request.resource.data.w.stats
        && request.resource.data.updated == request.time
        && throttled();
    }

    // ---- live scale forms ----
    match /forms/{fid} {
      // anyone with the link can read an open form; the owner can always read it
      allow read: if resource.data.open == true || isUser(resource.data.owner);
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['owner', 'title', 'def', 'open', 'created'])
        && request.resource.data.owner == request.auth.uid
        && isStr(request.resource.data.title, 120) && isStr(request.resource.data.def, 100000)
        && request.resource.data.open is bool && request.resource.data.created == request.time;
      allow update: if isUser(resource.data.owner)
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['open', 'def', 'title'])
        && isStr(request.resource.data.def, 100000) && isStr(request.resource.data.title, 120) && request.resource.data.open is bool;
      allow delete: if isUser(resource.data.owner);

      // responses: anyone may submit to an OPEN form; only the form owner may read or delete them; nobody edits them
      match /responses/{rid} {
        allow create: if get(/databases/$(database)/documents/forms/$(fid)).data.open == true
          && request.resource.data.keys().hasOnly(['r', 'v', 'g', 'a', 'ts'])
          && request.resource.data.r is string && request.resource.data.r.matches('^[0-7]{1,200}$')
          && isStr(request.resource.data.v, 20) && isStr(request.resource.data.g, 10) && isStr(request.resource.data.a, 3)
          && request.resource.data.ts == request.time;
        allow read, delete: if isUser(get(/databases/$(database)/documents/forms/$(fid)).data.owner);
        allow update: if false;
      }
    }

    // ---- admins: the site owner (email set at deploy time, never committed) or anyone holding an invite ----
    function ownerEmail() { return '__OWNER_EMAIL__'; }
    match /admins/{uid} {
      allow read: if isUser(uid) || isAdmin();
      allow create: if isUser(uid) && verified()
        && (request.auth.token.email == ownerEmail() || exists(/databases/$(database)/documents/invites/$(request.auth.token.email)))
        && request.resource.data.keys().hasOnly(['role', 'email', 'name', 'added'])
        && request.resource.data.email == request.auth.token.email
        && isStr(request.resource.data.name, 60) && request.resource.data.role == 'admin'
        && request.resource.data.added == request.time;
      allow delete: if isAdmin();
      allow update: if false;
    }
    // ---- admin invitations, one document per invited email (lower case) ----
    match /invites/{em} {
      allow read: if isAdmin() || (signedIn() && request.auth.token.email == em);
      allow create: if isAdmin() && em == em.lower() && em.matches('^[^@\\s]+@[^@\\s]+$')
        && request.resource.data.keys().hasOnly(['by', 'created'])
        && request.resource.data.by == request.auth.uid && request.resource.data.created == request.time;
      allow delete: if isAdmin() || (signedIn() && request.auth.token.email == em);
      allow update: if false;
    }

    // ---- know-yourself results shared by name with the site admin (explicit consent) ----
    match /know/{uid} {
      allow read: if isUser(uid) || isAdmin();
      allow delete: if isUser(uid) || isAdmin();
      allow create, update: if isUser(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'consent', 'results', 'done', 'updated'])
        && request.resource.data.consent == true
        && isStr(request.resource.data.name, 60)
        && request.resource.data.email == request.auth.token.email
        && isStr(request.resource.data.results, 60000)
        && isInt(request.resource.data.done, 20)
        && request.resource.data.updated == request.time
        && throttled();
    }

    // ---- tests-library results shared by name with the admin (same consent as know) ----
    match /tests/{uid} {
      allow read: if isUser(uid) || isAdmin();
      allow delete: if isUser(uid) || isAdmin();
      allow create, update: if isUser(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'consent', 'results', 'done', 'updated'])
        && request.resource.data.consent == true
        && isStr(request.resource.data.name, 60)
        && request.resource.data.email == request.auth.token.email
        && isStr(request.resource.data.results, 60000)
        && isInt(request.resource.data.done, 40)
        && request.resource.data.updated == request.time
        && throttled();
    }

    // ---- stage gates set by the admin: 'global' for everyone, or one document per student ----
    match /gates/{gid} {
      allow read: if signedIn() && (gid == 'global' || gid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['mode', 'upto', 'hold', 'released', 'note', 'updated'])
        && request.resource.data.mode in ['inherit', 'seq', 'open', 'locked', 'upto']
        && isInt(request.resource.data.upto, 20)
        && request.resource.data.hold is bool && request.resource.data.released is bool
        && isStr(request.resource.data.note, 300)
        && request.resource.data.updated == request.time;
    }

    // everything else is closed
    match /{document=**} { allow read, write: if false; }
  }
}
